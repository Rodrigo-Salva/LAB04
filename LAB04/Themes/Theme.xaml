<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================= Paleta ============================= -->
    <SolidColorBrush x:Key="ColorFondo"        Color="#F4F6FB"/>
    <SolidColorBrush x:Key="ColorSuperficie"   Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ColorBorde"        Color="#E2E8F0"/>
    <SolidColorBrush x:Key="ColorTexto"        Color="#1F2937"/>
    <SolidColorBrush x:Key="ColorTextoSuave"   Color="#6B7280"/>

    <SolidColorBrush x:Key="ColorPrimario"        Color="#2F6FED"/>
    <SolidColorBrush x:Key="ColorPrimarioHover"   Color="#2559C4"/>
    <SolidColorBrush x:Key="ColorPrimarioPresion" Color="#1E4CA8"/>

    <SolidColorBrush x:Key="ColorPeligro"        Color="#DC2626"/>
    <SolidColorBrush x:Key="ColorPeligroHover"   Color="#B91C1C"/>

    <SolidColorBrush x:Key="ColorExito"  Color="#16A34A"/>

    <SolidColorBrush x:Key="ColorBarraLateral"       Color="#1B2430"/>
    <SolidColorBrush x:Key="ColorBarraLateralHover"  Color="#2A3746"/>
    <SolidColorBrush x:Key="ColorBarraLateralActivo" Color="#2F6FED"/>
    <SolidColorBrush x:Key="ColorTextoClaro"         Color="#E5E9F0"/>
    <SolidColorBrush x:Key="ColorTextoClaroSuave"    Color="#9AA5B4"/>

    <!-- ============================= Tarjetas ============================= -->
    <DropShadowEffect x:Key="SombraTarjeta" Color="#1F2937" Direction="270" ShadowDepth="1.5" BlurRadius="14" Opacity="0.08"/>

    <!-- Panel blanco elevado: lista o formulario principal de cada vista -->
    <Style x:Key="Tarjeta" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ColorSuperficie}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ColorBorde}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Effect" Value="{StaticResource SombraTarjeta}"/>
    </Style>

    <!-- Panel plano interior (barra de filtros/búsqueda dentro de una tarjeta), sin sombra propia -->
    <Style x:Key="SubTarjeta" TargetType="Border">
        <Setter Property="Background" Value="#F8FAFC"/>
        <Setter Property="BorderBrush" Value="{StaticResource ColorBorde}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="12"/>
    </Style>

    <!-- ============================= Base ============================= -->
    <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource ColorFondo}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="TextElement.Foreground" Value="{StaticResource ColorTexto}"/>
    </Style>

    <Style TargetType="UserControl">
        <Setter Property="Background" Value="{StaticResource ColorFondo}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="TextElement.Foreground" Value="{StaticResource ColorTexto}"/>
    </Style>

    <Style TargetType="TextBlock">
        <!-- Sin Setter de Foreground: hereda el color de su contenedor (Window/UserControl
             lo fija en ColorTexto; un Button con Foreground propio -p.ej. blanco- lo sobrescribe
             para su contenido). Así el texto dentro de botones de la barra lateral se ve bien. -->
        <Setter Property="Margin" Value="0,0,0,2"/>
    </Style>

    <!-- Título de sección grande ("Productos", "Categorías", ...) -->
    <Style x:Key="TituloSeccion" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource ColorTexto}"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <!-- Subtítulo de un panel ("Mantenimiento", "Datos del pedido", ...) -->
    <Style x:Key="TituloPanel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource ColorPrimario}"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

    <!-- Etiqueta de campo ("Nombre:", "Ciudad:", ...) -->
    <Style x:Key="Etiqueta" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource ColorTextoSuave}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Margin" Value="0,6,0,2"/>
    </Style>

    <!-- ============================= TextBox / ComboBox / DatePicker ============================= -->
    <Style TargetType="TextBox">
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="Background" Value="{StaticResource ColorSuperficie}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ColorBorde}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CaretBrush" Value="{StaticResource ColorTexto}"/>
        <Style.Triggers>
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource ColorPrimario}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ComboBoxItemPlano" TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="fondo" Background="{TemplateBinding Background}">
                        <ContentPresenter Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="fondo" Property="Background" Value="#EEF2F9"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="fondo" Property="Background" Value="{StaticResource ColorPrimario}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="Background" Value="{StaticResource ColorSuperficie}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ColorBorde}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource ComboBoxItemPlano}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="toggle" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="fondo" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            CornerRadius="6">
                                        <Path Data="M0,0 L4,4 L8,0" Stroke="{StaticResource ColorTextoSuave}" StrokeThickness="1.6"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="fondo" Property="BorderBrush" Value="{StaticResource ColorPrimario}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          Margin="10,7,28,7"
                                          HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Slide">
                            <Border Background="{StaticResource ColorSuperficie}" BorderBrush="{StaticResource ColorBorde}"
                                    BorderThickness="1" CornerRadius="6" Margin="0,4,0,0" MaxHeight="280"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                    Effect="{StaticResource SombraTarjeta}">
                                <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DatePicker">
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="Background" Value="{StaticResource ColorSuperficie}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ColorBorde}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Margin" Value="0,4,0,4"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- ============================= Botones ============================= -->
    <Style x:Key="BotonBase" TargetType="Button">
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="fondo" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="fondo" Property="Background" Value="{Binding Path=Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botón por defecto: acción neutra (Nuevo, Ver todos, Quitar línea...) -->
    <Style TargetType="Button" BasedOn="{StaticResource BotonBase}">
        <Setter Property="Background" Value="{StaticResource ColorSuperficie}"/>
        <Setter Property="Foreground" Value="{StaticResource ColorTexto}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ColorBorde}"/>
        <Setter Property="Tag" Value="{StaticResource ColorFondo}"/>
    </Style>

    <!-- Acción principal: Guardar, Buscar, Agregar línea, Generar reporte -->
    <Style x:Key="BotonPrimario" TargetType="Button" BasedOn="{StaticResource BotonBase}">
        <Setter Property="Background" Value="{StaticResource ColorPrimario}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource ColorPrimario}"/>
        <Setter Property="Tag" Value="{StaticResource ColorPrimarioHover}"/>
    </Style>

    <!-- Acción destructiva: Eliminar -->
    <Style x:Key="BotonPeligro" TargetType="Button" BasedOn="{StaticResource BotonBase}">
        <Setter Property="Background" Value="{StaticResource ColorPeligro}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource ColorPeligro}"/>
        <Setter Property="Tag" Value="{StaticResource ColorPeligroHover}"/>
    </Style>

    <!-- Botón de navegación de la barra lateral -->
    <Style x:Key="BotonNavegacion" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource ColorTextoClaroSuave}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="16,12"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="fondo" Background="{TemplateBinding Background}" CornerRadius="6" Margin="8,2">
                        <ContentPresenter Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="fondo" Property="Background" Value="{StaticResource ColorBarraLateralHover}"/>
                            <Setter Property="Foreground" Value="{StaticResource ColorTextoClaro}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Variante activa (sección actualmente visible) -->
    <Style x:Key="BotonNavegacionActivo" TargetType="Button" BasedOn="{StaticResource BotonNavegacion}">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{StaticResource ColorBarraLateralActivo}" CornerRadius="6" Margin="8,2">
                        <ContentPresenter Margin="{TemplateBinding Padding}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Un estilo de navegación por sección, resaltado cuando SeccionActual coincide -->
    <Style x:Key="BotonNavProductos" TargetType="Button" BasedOn="{StaticResource BotonNavegacion}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding SeccionActual}" Value="Productos">
                <Setter Property="Background" Value="{StaticResource ColorBarraLateralActivo}"/>
                <Setter Property="Foreground" Value="White"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="BotonNavCategorias" TargetType="Button" BasedOn="{StaticResource BotonNavegacion}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding SeccionActual}" Value="Categorias">
                <Setter Property="Background" Value="{StaticResource ColorBarraLateralActivo}"/>
                <Setter Property="Foreground" Value="White"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="BotonNavProveedores" TargetType="Button" BasedOn="{StaticResource BotonNavegacion}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding SeccionActual}" Value="Proveedores">
                <Setter Property="Background" Value="{StaticResource ColorBarraLateralActivo}"/>
                <Setter Property="Foreground" Value="White"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="BotonNavPedidos" TargetType="Button" BasedOn="{StaticResource BotonNavegacion}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding SeccionActual}" Value="Pedidos">
                <Setter Property="Background" Value="{StaticResource ColorBarraLateralActivo}"/>
                <Setter Property="Foreground" Value="White"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ============================= DataGrid ============================= -->
    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{StaticResource ColorSuperficie}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ColorBorde}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="RowHeaderWidth" Value="0"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource ColorBorde}"/>
        <Setter Property="RowBackground" Value="{StaticResource ColorSuperficie}"/>
        <Setter Property="AlternatingRowBackground" Value="#F8FAFC"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserResizeRows" Value="False"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="RowHeight" Value="30"/>
        <Setter Property="SelectionUnit" Value="FullRow"/>
        <Setter Property="SelectionMode" Value="Single"/>
    </Style>

    <!-- Se conserva el comportamiento de zebra-striping por defecto (AlternationIndex) y se añade hover -->
    <Style TargetType="DataGridRow">
        <Style.Triggers>
            <Trigger Property="AlternationIndex" Value="1">
                <Setter Property="Background" Value="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=AlternatingRowBackground}"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#EEF2F9"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#EEF2F9"/>
        <Setter Property="Foreground" Value="{StaticResource ColorTextoSuave}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="8,8"/>
        <Setter Property="BorderBrush" Value="{StaticResource ColorBorde}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource ColorTexto}"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource ColorPrimario}"/>
                <Setter Property="Foreground" Value="White"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================= TabControl ============================= -->
    <Style TargetType="TabControl">
        <Setter Property="Padding" Value="0"/>
    </Style>

    <!-- Pestaña plana con indicador inferior en vez del cromo clásico de Windows -->
    <Style TargetType="TabItem">
        <Setter Property="Padding" Value="16,10"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource ColorTextoSuave}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="borde" Background="Transparent" BorderThickness="0,0,0,3" BorderBrush="Transparent"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="borde" Property="BorderBrush" Value="{StaticResource ColorPrimario}"/>
                            <Setter Property="Foreground" Value="{StaticResource ColorPrimario}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource ColorPrimario}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================= ScrollBar (delgado) ============================= -->
    <Style x:Key="PulgarScroll" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="#C7CFDA" CornerRadius="4" Margin="2"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10"/>
        <Setter Property="Height" Value="10"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid>
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource PulgarScroll}"/>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Height" Value="10"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid>
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" Focusable="False"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" Focusable="False"/>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource PulgarScroll}"/>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
