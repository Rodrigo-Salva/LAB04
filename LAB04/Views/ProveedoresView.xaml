<UserControl x:Class="LAB04.Views.ProveedoresView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:LAB04.ViewModels"
             xmlns:conv="clr-namespace:LAB04.Converters"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="600"
             d:DataContext="{d:DesignInstance Type=vm:ProveedoresViewModel}">
    <UserControl.Resources>
        <conv:BoolAErrorBrushConverter x:Key="BoolAErrorBrush"/>
    </UserControl.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Proveedores" Style="{StaticResource TituloSeccion}" Margin="0"/>

        <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource Tarjeta}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource SubTarjeta}" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Contacto:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Text="{Binding BuscarContacto, UpdateSourceTrigger=PropertyChanged}" Width="160" Margin="0,0,16,0"/>
                        <TextBlock Text="Ciudad:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Text="{Binding BuscarCiudad, UpdateSourceTrigger=PropertyChanged}" Width="140" Margin="0,0,16,0"/>
                        <Button Content="Buscar" Style="{StaticResource BotonPrimario}" Command="{Binding BuscarCommand}"/>
                        <Button Content="Ver todos" Margin="8,0,0,0" Command="{Binding LimpiarBusquedaCommand}"/>
                    </StackPanel>
                </Border>
                <DataGrid ItemsSource="{Binding Proveedores}" SelectedItem="{Binding ProveedorSeleccionado}"
                          AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Id" Binding="{Binding IdProveedor}" Width="40"/>
                        <DataGridTextColumn Header="Compañía" Binding="{Binding NombreCompania}" Width="180"/>
                        <DataGridTextColumn Header="Contacto" Binding="{Binding NombreContacto}" Width="150"/>
                        <DataGridTextColumn Header="Cargo" Binding="{Binding Cargo}" Width="130"/>
                        <DataGridTextColumn Header="Ciudad" Binding="{Binding Ciudad}" Width="100"/>
                        <DataGridTextColumn Header="País" Binding="{Binding Pais}" Width="90"/>
                        <DataGridTextColumn Header="Teléfono" Binding="{Binding Telefono}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="2" Style="{StaticResource Tarjeta}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Mantenimiento" Style="{StaticResource TituloPanel}"/>
                    <TextBlock Text="Compañía" Style="{StaticResource Etiqueta}"/>
                    <TextBox Text="{Binding NombreCompania, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Contacto" Style="{StaticResource Etiqueta}"/>
                    <TextBox Text="{Binding NombreContacto, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Cargo" Style="{StaticResource Etiqueta}"/>
                    <TextBox Text="{Binding Cargo, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Dirección" Style="{StaticResource Etiqueta}"/>
                    <TextBox Text="{Binding Direccion, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Ciudad" Style="{StaticResource Etiqueta}"/>
                    <TextBox Text="{Binding Ciudad, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Código postal" Style="{StaticResource Etiqueta}"/>
                    <TextBox Text="{Binding CodigoPostal, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="País" Style="{StaticResource Etiqueta}"/>
                    <TextBox Text="{Binding Pais, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Teléfono" Style="{StaticResource Etiqueta}"/>
                    <TextBox Text="{Binding Telefono, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Fax" Style="{StaticResource Etiqueta}"/>
                    <TextBox Text="{Binding Fax, UpdateSourceTrigger=PropertyChanged}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Content="Nuevo" Margin="0,0,6,0" Command="{Binding NuevoCommand}"/>
                        <Button Content="Guardar" Style="{StaticResource BotonPrimario}" Margin="0,0,6,0" Command="{Binding GuardarCommand}"/>
                        <Button Content="Eliminar" Style="{StaticResource BotonPeligro}" Command="{Binding EliminarCommand}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Mensaje}" Foreground="{Binding EsError, Converter={StaticResource BoolAErrorBrush}}"
                               TextWrapping="Wrap" Margin="0,12,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
