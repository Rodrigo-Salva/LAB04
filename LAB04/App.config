<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <connectionStrings>
    <!-- Ajusta el Data Source según tu instancia de SQL Server.
         SQL Server Express (en uso): LENOVO\SQLEXPRESS
         LocalDB:                     (localdb)\MSSQLLocalDB
         SQL Server completo:          localhost  o  NOMBRE_SERVIDOR -->
    <add name="NeptunoDB"
         connectionString="Data Source=LENOVO\SQLEXPRESS;Initial Catalog=NeptunoDB;Integrated Security=True;TrustServerCertificate=True"
         providerName="Microsoft.Data.SqlClient" />
  </connectionStrings>
</configuration>
